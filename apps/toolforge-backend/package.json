{
  "name": "perseus-toolforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Toolforge-native backend for the Perseus Wikipedia gadget",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "prebuild": "pnpm --filter @perseus/core build",
    "build": "tsup",
    "build:toolforge": "pnpm build && node scripts/prepare-toolforge.mjs",
    "start": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.1",
    "linkedom": "^0.18.13",
    "mysql2": "^3.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@perseus/core": "workspace:*",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
