{
  "name": "perseus",
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "prepare": "simple-git-hooks",
    "test": "nx run-many -t test",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "dev:desktop": "pnpm --filter perseus-desktop tauri dev",
    "build": "nx run-many -t build",
    "build:core": "pnpm --filter @perseus/core build",
    "build:desktop": "pnpm --filter perseus-desktop tauri build",
    "deploy": "pnpm --filter perseus-backend deploy",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "nx": "23.1.1",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint",
    "pre-push": "pnpm --filter @perseus/core test"
  }
}
