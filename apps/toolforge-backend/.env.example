# Public origin of this backend (no trailing slash).
PUBLIC_BASE_URL=https://perseus.toolforge.org

# HTTP port. Toolforge sets PORT=8000 for Kubernetes webservices.
PORT=8000

# MariaDB / Toolforge user database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=perseus
DB_PASSWORD=change-me
DB_NAME=perseus

# Wikimedia OAuth 2.0 consumer (register at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose).
# The callback must be exactly ${PUBLIC_BASE_URL}/auth/callback.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://perseus.toolforge.org/auth/callback
# Optional. Wikimedia's default profile scope is enough for identity.
OAUTH_SCOPE=

# AI provider. The key must never be exposed to the gadget.
OPENROUTER_API_KEY=
PERSEUS_MODEL=google/gemini-2.5-flash

# Wikimedia API etiquette. Use a real contact address or project URL.
PERSEUS_USER_AGENT=Perseus Toolforge Backend/0.1 (https://github.com/wikimediairan/Perseus; contact: change-me)

# Operational limits.
JOB_RETENTION_HOURS=24
JOB_METADATA_RETENTION_DAYS=30
MAX_ARTICLE_BYTES=2000000
MAX_CHUNKS=60
MAX_JOBS_PER_DAY=10
CHUNK_RETRIES=3
AI_REQUEST_TIMEOUT_MS=120000
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=180
SESSION_TTL_DAYS=30
OAUTH_STATE_TTL_MINUTES=10
GADGET_CODE_TTL_SECONDS=120

# Comma-separated extra CORS origins for local development only, e.g.
# http://localhost:5173. Production source wikis are matched automatically.
CORS_EXTRA_ORIGINS=
