{
  "name": "perseus-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/views/styles.css -o ./public/static/app.css --minify",
    "dev:css": "tailwindcss -i ./src/views/styles.css -o ./public/static/app.css --watch",
    "dev": "concurrently -n css,worker -c blue,green \"pnpm dev:css\" \"wrangler dev\"",
    "deploy": "pnpm --filter @perseus/core build && pnpm build:css && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "db:create": "wrangler d1 create perseus-db",
    "db:migrate:local": "wrangler d1 migrations apply perseus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply perseus-db --remote"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@perseus/core": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "hono": "^4.12.32",
    "linkedom": "^0.18.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
