{
  "name": "perseus",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "prepare": "simple-git-hooks",
    "test": "nx run-many -t test",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "dev:desktop": "pnpm --filter perseus-desktop tauri dev",
    "build": "nx run-many -t build",
    "build:core": "pnpm --filter @perseus/core build",
    "build:desktop": "pnpm --filter perseus-desktop tauri build",
    "deploy": "pnpm --filter perseus-backend deploy",
    "comments": "node scripts/comments.cjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "ignore": "7.0.13",
    "@biomejs/biome": "2.5.5",
    "nx": "23.1.1",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint",
    "pre-push": "pnpm --filter @perseus/core test"
  }
}
